# Handle to a pending Resend send, written by `deliver.py arm` and consumed by
# `deliver.py send`. Run-local state, never project state.
.resend-alert-id

# Working file for the day's issue; the rendered output in issues/ is the
# artefact worth versioning, not the intermediate.
content.json

# Per-part fragments written by the drafting session and consumed by
# assemble.py. Same rationale as content.json: run-local intermediate, not
# project state. Kept out of git deliberately - the recovery path for a dead
# session is `scripts/publish.sh work/` on the live filesystem, which does not
# need these versioned.
work/

__pycache__/
*.pyc
.DS_Store
.env
